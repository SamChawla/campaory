# Copy to .env. Never commit .env.
APP_ENV=development
BASE_URL=http://localhost:8000
SESSION_SECRET=change-me-to-64-random-hex-chars
DATABASE_URL=sqlite:///./dev.db

# mock | euri
LLM_PROVIDER=mock
LLM_FALLBACK_TO_MOCK=false
LLM_TIMEOUT_SECONDS=25
# Euri (OpenAI-compatible), serves Gemma 4
EURI_API_KEY=
EURI_MODEL=google/gemma-4-26B-A4B-it
EURI_BASE_URL=https://api.euron.one/api/v1/euri

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

RATE_GUEST_PER_HOUR=10
RATE_GUEST_PER_DAY=30
RATE_USER_PER_HOUR=40
RATE_IP_PER_MINUTE=120
LLM_DAILY_CAP=500
FREE_PLAN_MAX_CAMPAIGNS=1

SENTRY_DSN=
